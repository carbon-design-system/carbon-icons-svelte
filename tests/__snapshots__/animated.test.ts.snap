"<script>
  import { animate, getAnimatedIconDefaults } from "./animate.js";

  export let size = 16;

  export let title = undefined;

  export let play = false;

  export let trigger = undefined;

  export let motion = undefined;

  export let reducedMotion = undefined;

  export let hoverDelay = undefined;

  const defaults = getAnimatedIconDefaults();

  $: labelled = $$props["aria-label"] || $$props["aria-labelledby"] || title;
  $: attributes = {
    "aria-hidden": labelled ? undefined : true,
    role: labelled ? "img" : undefined,
    focusable: Number($$props["tabindex"]) === 0 ? true : undefined
  };
</script>

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  fill="currentColor"
  preserveAspectRatio="xMidYMid meet"
  width={size}
  height={size}
  data-motion={motion ?? defaults.motion ?? "productive"}
  use:animate={{ play, trigger, reducedMotion, hoverDelay, defaults }}
  {...attributes}
  {...$$restProps}>
  {#if title}<title>{title}</title>{/if}
  <path class="clapper" d="M11,24v.7768a5.152,5.152,0,0,0,4.5,5.1987A5.0057,5.0057,0,0,0,21,25V24ZM19,25a3,3,0,0,1-6,0V24h6Z" />
  <path class="bell" d="M28.7071,19.293,26,16.5859V13a10.0136,10.0136,0,0,0-9-9.9492V1H15V3.0508A10.0136,10.0136,0,0,0,6,13v3.5859L3.2929,19.293A1,1,0,0,0,3,20v3a1,1,0,0,0,1,1H28a1,1,0,0,0,1-1V20A1,1,0,0,0,28.7071,19.293ZM27,22H5V20.4141L7.707,17.707A1,1,0,0,0,8,17V13a8,8,0,0,1,16,0v4a1,1,0,0,0,.293.707L27,20.4141Z" />
</svg>

<style>
  .bell,
  .clapper {
    transform-box: view-box;
    transform-origin: 16px 1px;
  }

  :global(svg[data-playing="motion"][data-motion="productive"]) .bell,
  :global(svg[data-playing="motion"][data-motion="productive"]) .clapper {
    animation: swing 400ms cubic-bezier(0.2, 0, 0.38, 0.9);
  }

  :global(svg[data-playing="motion"][data-motion="expressive"]) .bell {
    animation: ring 700ms cubic-bezier(0.4, 0.14, 0.3, 1);
  }

  :global(svg[data-playing="motion"][data-motion="expressive"]) .clapper {
    animation: ring-clapper 700ms cubic-bezier(0.4, 0.14, 0.3, 1);
  }

  @keyframes swing {
    35% {
      transform: rotate(6deg);
    }
    70% {
      transform: rotate(-4deg);
    }
  }

  @keyframes ring {
    14% {
      transform: rotate(8deg);
    }
    32% {
      transform: rotate(-7deg);
    }
    50% {
      transform: rotate(5deg);
    }
    68% {
      transform: rotate(-3deg);
    }
    84% {
      transform: rotate(1deg);
    }
  }

  @keyframes ring-clapper {
    0%,
    5% {
      transform: rotate(0);
    }
    19% {
      transform: rotate(12deg);
    }
    37% {
      transform: rotate(-10deg);
    }
    55% {
      transform: rotate(7deg);
    }
    72% {
      transform: rotate(-4deg);
    }
    88% {
      transform: rotate(1.5deg);
    }
  }
</style>
"
