exports[`animated icons template 1`] = `
"<script>
  import { animate } from "./animate.js";

  export let size = 16;

  export let title = undefined;

  export let play = false;

  export let trigger = "hover";

  export let motion = "productive";

  $: labelled = $$props["aria-label"] || $$props["aria-labelledby"] || title;
  $: attributes = {
    "aria-hidden": labelled ? undefined : true,
    role: labelled ? "img" : undefined,
    focusable: Number($$props["tabindex"]) === 0 ? true : undefined
  };
</script>

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  fill="currentColor"
  preserveAspectRatio="xMidYMid meet"
  width={size}
  height={size}
  data-motion={motion}
  use:animate={{ play, trigger }}
  {...attributes}
  {...$$restProps}>
  {#if title}<title>{title}</title>{/if}
  <path class="clapper" d="M11,24v.7768a5.152,5.152,0,0,0,4.5,5.1987A5.0057,5.0057,0,0,0,21,25V24ZM19,25a3,3,0,0,1-6,0V24h6Z" />
  <path class="bell" d="M28.7071,19.293,26,16.5859V13a10.0136,10.0136,0,0,0-9-9.9492V1H15V3.0508A10.0136,10.0136,0,0,0,6,13v3.5859L3.2929,19.293A1,1,0,0,0,3,20v3a1,1,0,0,0,1,1H28a1,1,0,0,0,1-1V20A1,1,0,0,0,28.7071,19.293ZM27,22H5V20.4141L7.707,17.707A1,1,0,0,0,8,17V13a8,8,0,0,1,16,0v4a1,1,0,0,0,.293.707L27,20.4141Z" />
</svg>

<style>
  .bell,
  .clapper {
    transform-box: view-box;
    transform-origin: 16px 1px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(svg[data-playing][data-motion="productive"]) .bell,
    :global(svg[data-playing][data-motion="productive"]) .clapper {
      animation: swing 400ms cubic-bezier(0.2, 0, 0.38, 0.9);
    }

    :global(svg[data-playing][data-motion="expressive"]) .bell {
      animation: ring 700ms cubic-bezier(0.4, 0.14, 0.3, 1);
    }

    :global(svg[data-playing][data-motion="expressive"]) .clapper {
      animation: ring-clapper 700ms cubic-bezier(0.4, 0.14, 0.3, 1);
    }
  }

  @keyframes swing {
    35% {
      transform: rotate(8deg);
    }
    70% {
      transform: rotate(-5deg);
    }
  }

  @keyframes ring {
    14% {
      transform: rotate(14deg);
    }
    32% {
      transform: rotate(-11deg);
    }
    50% {
      transform: rotate(7deg);
    }
    68% {
      transform: rotate(-4deg);
    }
    84% {
      transform: rotate(1.5deg);
    }
  }

  /* The same swing, starting later and going further. */
  @keyframes ring-clapper {
    0%,
    5% {
      transform: rotate(0);
    }
    19% {
      transform: rotate(20deg);
    }
    37% {
      transform: rotate(-15deg);
    }
    55% {
      transform: rotate(10deg);
    }
    72% {
      transform: rotate(-5deg);
    }
    88% {
      transform: rotate(2deg);
    }
  }
</style>
"
`;

exports[`animated icons build output 1`] = `
"import type { ComponentConstructorOptions, SvelteComponent } from "svelte";
import type { CarbonIconProps } from "../index.js";

export type CarbonAnimatedIconProps = CarbonIconProps & {
  /**
   * Plays the animation each time this changes to a truthy value.
   * Increment a number to replay it on demand.
   * @default false
   */
  play?: boolean | number;

  /**
   * \`"hover"\` plays the animation when the pointer enters the icon or the
   * link, button, label or summary around it, or when that gets keyboard focus.
   * \`"none"\` plays it only through \`play\`.
   * @default "hover"
   */
  trigger?: "hover" | "none";

  /**
   * Carbon's motion style. \`"productive"\` is short and subtle, for routine UI.
   * \`"expressive"\` is larger and livelier, for moments that matter.
   * @default "productive"
   */
  motion?: "productive" | "expressive";
};

/** See \`CarbonIcon\` in \`../index.d.ts\`. */
type CarbonAnimatedIcon = typeof import("svelte") extends { mount: any }
  ? (this: void, internals: unknown, props: CarbonAnimatedIconProps) => {}
  : new (
      options: ComponentConstructorOptions<CarbonAnimatedIconProps>
    ) => SvelteComponent<CarbonAnimatedIconProps, Record<string, any>, {}>;

export declare const Add: CarbonAnimatedIcon;
export declare const Checkmark: CarbonAnimatedIcon;
export declare const ChevronRight: CarbonAnimatedIcon;
export declare const Copy: CarbonAnimatedIcon;
export declare const Download: CarbonAnimatedIcon;
export declare const Edit: CarbonAnimatedIcon;
export declare const Favorite: CarbonAnimatedIcon;
export declare const Light: CarbonAnimatedIcon;
export declare const Location: CarbonAnimatedIcon;
export declare const Locked: CarbonAnimatedIcon;
export declare const Notification: CarbonAnimatedIcon;
export declare const Renew: CarbonAnimatedIcon;
export declare const Search: CarbonAnimatedIcon;
export declare const Send: CarbonAnimatedIcon;
export declare const Settings: CarbonAnimatedIcon;
export declare const Star: CarbonAnimatedIcon;
export declare const Time: CarbonAnimatedIcon;
export declare const TrashCan: CarbonAnimatedIcon;
export declare const Upload: CarbonAnimatedIcon;
export declare const View: CarbonAnimatedIcon;
export declare const VolumeUp: CarbonAnimatedIcon;
export declare const WarningAlt: CarbonAnimatedIcon;
export declare const Wifi: CarbonAnimatedIcon;
"
`;
